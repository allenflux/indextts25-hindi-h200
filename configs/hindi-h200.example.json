{
  "repo": "../index-tts",
  "model_dir": "../index-tts/checkpoints",
  "output_dir": "runs/hi_h200_smoke",
  "train_manifests": [
    "prepared/pairs_train.jsonl::hi"
  ],
  "val_manifests": [
    "prepared/pairs_val.jsonl::hi"
  ],
  "lang": "hi",
  "lang_init_from": "en",
  "train_all_lang_rows": false,
  "trainable_mode": "lora",
  "lora_rank": 16,
  "lora_alpha": 32.0,
  "lora_dropout": 0.0,
  "train_text_embedding": false,
  "train_text_rows": true,
  "text_row_min_count": 1,
  "text_row_max_base_norm": 0.5,
  "text_row_init": "keep",
  "text_lr_multiplier": 2.0,
  "train_heads": true,
  "preserve_emotion": true,
  "batch_size": 2,
  "grad_accumulation": 8,
  "epochs": 1000,
  "max_steps": 100,
  "learning_rate": 5e-05,
  "lang_lr_multiplier": 2.0,
  "warmup_steps": 10,
  "amp": "bf16",
  "num_workers": 2,
  "seed": 1234,
  "log_interval": 1,
  "val_interval": 25,
  "save_interval": 25,
  "keep_checkpoints": 3,
  "final_export": "adapter",
  "normalizer": "none",
  "case": "none",
  "resume": ""
}
